      <joint name="OBJTz" type="slide" pos="0 0 0" axis="0 0 1"
             limited="false" damping="0" armature="0.001"
             frictionloss="0.001" margin="0.01"/>
      <joint name="OBJRx" type="hinge" pos="0 0 0" axis="1 0 0"
             limited="false" damping="0.1" armature="0.001"
             frictionloss="0.001" margin="0.01"/>
      <joint name="OBJRy" type="hinge" pos="0 0 0" axis="0 1 0"
             limited="false" damping="0.1" armature="0.001"
             frictionloss="0.001" margin="0.01"/>
      <joint name="OBJRz" type="hinge" pos="0 0 0" axis="0 0 1"
             limited="false" damping="0.1" armature="0.001"
             frictionloss="0.001" margin="0.01"/>

      <!-- 木质锤柄：胶囊体，直径为 5 厘米，总长度为 15 厘米。 -->
      <geom name="handle" type="capsule" size="0.025 0.05"
            quat="0.707388 0 0.706825 0"
            rgba="0.60 0.39 0.23 1" condim="4"
            contype="1" conaffinity="1"
            friction="1 0.5 0.01" margin="0.0005"/>

      <!-- 细连接杆：胶囊体，直径为 1.4 厘米，总长度为 18.4 厘米。 -->
      <geom name="neck" type="capsule" pos="-0.14 0 0"
            size="0.007 0.085" quat="0.707388 0 0.706825 0"
            rgba="1 1 1 1" condim="4"
            contype="1" conaffinity="1"
            friction="1 0.5 0.01" margin="0.0005"/>

      <!-- 锤头：靠把手端长8cm；远离把手端长6cm且削出宽2cm的接触平面。 -->
      <geom name="head" type="mesh" mesh="head_bevel_mesh"
            pos="-0.24 0 0" quat="0 0 0 1"
            rgba="0.4 0.4 0.4 1" condim="4"
            contype="1" conaffinity="1"
            friction="1 0.5 0.01" margin="0.0005"/>

      <!-- 原始参考标记点（不参与碰撞）。 -->
      <site name="tool" type="sphere" pos="-0.2 0 -0.04"
            size="0.01" group="4" rgba="0.4 0.8 0.4 1"/>
    </body>
