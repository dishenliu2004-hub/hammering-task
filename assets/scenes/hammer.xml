  <worldbody>
    <body name="Object" pos="0 -0.2 0.035" quat="0.707388 0.706825 0 0">
      <!-- 原始完整锤子的惯性参数。 -->
      <inertial pos="-0.11025 0 0"
                quat="0.50001 0.49999 0.49999 0.50001"
                mass="0.253442"
                diaginertia="0.00349644 0.00345287 8.947e-05"/>

      <!-- 原始六个无位移或角度限位的关节；默认参数已显式写出。 -->
      <joint name="OBJTx" type="slide" pos="0 0 0" axis="1 0 0"
             limited="false" damping="0" armature="0.001"
             frictionloss="0.001" margin="0.01"/>
      <joint name="OBJTy" type="slide" pos="0 0 0" axis="0 1 0"
             limited="false" damping="0" armature="0.001"
