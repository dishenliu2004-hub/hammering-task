def Scope "Materials"
{
    def Material "m_opaque__wood__unique_body_a01" (
        prepend apiSchemas = ["SemanticsLabelsAPI:material"]
    )
    {
        custom token[] omni:simready:nonvisual:attributes = ["none"]
        custom token omni:simready:nonvisual:base = "wood"
        custom token omni:simready:nonvisual:coating = "none"
        token outputs:displacement (
            displayGroup = "Outputs"
        )
        prepend token outputs:mdl:surface.connect = </Materials/m_opaque__wood__unique_body_a01/OmniPBR_Shader.outputs:out>
        token outputs:surface (
            displayGroup = "Outputs"
        )
        prepend token outputs:surface.connect = </Materials/m_opaque__wood__unique_body_a01/Principled_BSDF.outputs:surface>
        token outputs:volume (
            displayGroup = "Outputs"
        )
        custom bool pbr_needs_sync = 1
        custom int pxr:usd:physics_density = 700
        custom double pxr:usd:physics_dynamicFriction = 0.5
        custom double pxr:usd:physics_fillRatio = 0.7
        custom double pxr:usd:physics_restitution = 0.4
        custom double pxr:usd:physics_staticFriction = 0.5
        custom double pxr:usd:physics_thickness = 0.02
        custom string pxr:usd:physics_type = "wood"
        token[] semantics:labels:material = ["wood"]

        def Shader "Principled_BSDF" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPreviewSurface"
            float inputs:clearcoat = 0
            float inputs:clearcoatRoughness = 0.03
            prepend color3f inputs:diffuseColor.connect = </Materials/m_opaque__wood__unique_body_a01/Albedo.outputs:rgb>
            float inputs:ior = 1.5
            prepend float inputs:metallic.connect = </Materials/m_opaque__wood__unique_body_a01/ORM.outputs:b>
            prepend normal3f inputs:normal.connect = </Materials/m_opaque__wood__unique_body_a01/Normal.outputs:rgb>
            float inputs:opacity = 1
            prepend float inputs:roughness.connect = </Materials/m_opaque__wood__unique_body_a01/ORM.outputs:g>
            float inputs:specular = 0.5
            token outputs:surface
        }

        def Shader "Albedo" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdUVTexture"
            asset inputs:file = @../Textures/t_tool_hammer_a03_alb.png@
            token inputs:sourceColorSpace = "sRGB"
            prepend float2 inputs:st.connect = </Materials/m_opaque__wood__unique_body_a01/Mapping.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float3 outputs:rgb
        }

        def Shader "Mapping" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdTransform2d"
            prepend float2 inputs:in.connect = </Materials/m_opaque__wood__unique_body_a01/uvmap.outputs:result>
            float inputs:rotation = 0
            float2 inputs:scale = (1, 1)
            float2 inputs:translation = (0, 0)
            float2 outputs:result
        }

        def Shader "uvmap" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPrimvarReader_float2"
            string inputs:varname = "st"
            float2 outputs:result
        }

        def Shader "ORM" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdUVTexture"
            asset inputs:file = @../Textures/t_tool_hammer_a03_orm.png@
            token inputs:sourceColorSpace = "raw"
            prepend float2 inputs:st.connect = </Materials/m_opaque__wood__unique_body_a01/Mapping.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float outputs:b
            float outputs:g
        }

        def Shader "Normal" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdUVTexture"
            float4 inputs:bias = (-1, -1, -1, -1)
            asset inputs:file = @../Textures/t_tool_hammer_a03_nor.png@
            float4 inputs:scale = (2, 2, 2, 2)
            token inputs:sourceColorSpace = "raw"
            prepend float2 inputs:st.connect = </Materials/m_opaque__wood__unique_body_a01/Mapping.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float3 outputs:rgb
        }

        def Shader "OmniPBR_Shader" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "mdl:OmniPBR"
            token info:implementationSource = "sourceAsset"
            asset info:mdl:sourceAsset = @../source_assets/OmniPBR.mdl@
            token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
            float inputs:bump_factor = 1
            asset inputs:diffuse_texture = @../Textures/t_tool_hammer_a03_alb.png@ (
                colorSpace = "sRGB"
            )
            color3f inputs:emissive_color = (1, 1, 1)
            float inputs:emissive_intensity = 0
            bool inputs:enable_ORM_texture = 1
            bool inputs:flip_tangent_u = 0
            bool inputs:flip_tangent_v = 1
            float inputs:metallic_texture_influence = 1
            asset inputs:normalmap_texture = @../Textures/t_tool_hammer_a03_nor.png@ (
                colorSpace = "raw"
            )
            float inputs:opacity_constant = 1
            asset inputs:ORM_texture = @../Textures/t_tool_hammer_a03_orm.png@ (
                colorSpace = "raw"
            )
            float inputs:reflection_roughness_texture_influence = 1
            float inputs:specular_level = 0.5
            float2 inputs:texture_scale = (1, 1)
            token outputs:out
        }
    }

